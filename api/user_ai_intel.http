  "password": "SecurePass123!",
  "accountType": "invalid_type"
}

###############################################################
# SECTION 10: VERIFY ACCOUNT
###############################################################

### 10.01 Verify account — success (expect 200)
### @name verifyAccountSuccess
POST {{baseUrl}}/api/user/staff_create_test/verify
Content-Type: application/json

### 10.02 Verify nonexistent — expect 404
### @name verifyNonexistent
POST {{baseUrl}}/api/user/does_not_exist_xyz/verify
Content-Type: application/json

###############################################################
# SECTION 11: SECTIONS
###############################################################

### 11.01 Get sections — empty (expect 200)
### @name getSectionsEmpty
GET {{baseUrl}}/api/user/section

### 11.02 Add sections — success (expect 200)
### @name addSections
POST {{baseUrl}}/api/user/section
Content-Type: application/json

{
  "sections": ["CSSE", "CSP"]
}

### 11.03 Add sections — empty list (expect 400)
### @name addSectionsEmpty
POST {{baseUrl}}/api/user/section
Content-Type: application/json

{
  "sections": []
}

### 11.04 Update section year — success (expect 200)
### @name updateSectionYear
PUT {{baseUrl}}/api/user/section
Content-Type: application/json

{
  "section": {
    "abbreviation": "CSSE",
    "year": 2025
  }
}

### 11.05 Update section — missing abbrev (expect 400)
### @name updateSectionMissingAbbrev
PUT {{baseUrl}}/api/user/section
Content-Type: application/json

{
  "section": {
    "year": 2025
  }
}

### 11.06 Delete sections — success (expect 200)
### @name deleteSections
DELETE {{baseUrl}}/api/user/section
Content-Type: application/json

{
  "sections": ["CSSE", "CSP"]
}

