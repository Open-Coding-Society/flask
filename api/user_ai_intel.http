###############################################################
# SECTION 15: PASSWORD RESET
###############################################################

### 15.01 Reset — missing fields (expect 400)
### @name resetPasswordMissing
POST {{baseUrl}}/api/reset-password
Content-Type: application/json

{"uid": "test"}

### 15.02 Reset — short password (expect 400)
### @name resetPasswordShort
POST {{baseUrl}}/api/reset-password
Content-Type: application/json

{
  "uid": "test",
  "resetToken": "some-token",
  "newPassword": "123"
}