# Presence system walkthrough (rooms, schedules, RFID taps, status).
# Select the REST Client environment, then send each numbered request top to bottom,
# checking the expected status in its heading. Reader requests prompt for the device
# key (RFID_API_KEY in the server's .env); never write it into this file.
# Creates real rows in the selected environment: a room, a schedule, a tag, and taps.
@roomName = Presence Demo Room
@scheduleName = Presence Demo Schedule
@tagUid = 1234567890
@newTagUid = 9876543210

### 1. Authenticate as an Admin or Teacher (expect 200)
# @name login
# @prompt uid Enter an Admin or Teacher user ID
# @prompt password Enter your password
POST {{baseUrl}}/api/authenticate
Content-Type: application/json
Accept: application/json

{
  "uid": "{{uid}}",
  "password": "{{password}}"
}

### 2. List schedules (expect 200; includes the seeded "Del Norte Regular")
GET {{baseUrl}}/api/presence/schedules
Accept: application/json

### 3. Create a schedule (expect 201; 409 with the existing id if it already exists)
# @name createSchedule
POST {{baseUrl}}/api/presence/schedules
Content-Type: application/json
Accept: application/json

{
  "name": "{{scheduleName}}",
  "timezone": "America/Los_Angeles",
  "grace_seconds": 300,
  "blocks": [
    {"name": "Morning", "weekdays": "mon,tue,wed,thu,fri", "start": "09:00", "end": "10:30"},
    {"name": "Afternoon", "weekdays": "mon,tue,wed,thu,fri", "start": "13:00", "end": "14:30"}
  ]
}

### 4. Edit the schedule: replaces its blocks (expect 200)
PUT {{baseUrl}}/api/presence/schedules/{{createSchedule.response.body.$.id}}
Content-Type: application/json
Accept: application/json

{
  "blocks": [
    {"name": "Morning", "weekdays": "mon,tue,wed,thu,fri", "start": "09:00", "end": "11:00"}
  ]
}

### 5. Create a room that follows the schedule, with you as a member (expect 201; 409 with the existing id if it exists)
# @name createRoom
POST {{baseUrl}}/api/presence/rooms
Content-Type: application/json
Accept: application/json

{
  "name": "{{roomName}}",
  "description": "Created by api/presence.http",
  "schedule_id": {{createSchedule.response.body.$.id}},
  "member_uids": ["{{login.response.body.$.user.uid}}"]
}

### 6. List rooms (expect 200; includes the new room)
GET {{baseUrl}}/api/presence/rooms
Accept: application/json

### 7. Register a tag to yourself, by uid (expect 201 new, 200 if it moves an existing tag)
POST {{baseUrl}}/api/rfid/tags
Content-Type: application/json
Accept: application/json

{
  "tag_uid": "{{tagUid}}",
  "uid": "{{login.response.body.$.user.uid}}"
}

### 8. Start a 30-minute manual period in the room; overrides its schedule (expect 201)
POST {{baseUrl}}/api/presence/rooms/{{createRoom.response.body.$.id}}/periods
Content-Type: application/json
Accept: application/json

{
  "name": "Demo Period",
  "duration_seconds": 1800
}

### 9. Tap, as the reader sends it (expect 200, event.type "enter")
# @name tap
# @prompt apiKey Enter the device key (RFID_API_KEY)
POST {{baseUrl}}/api/rfid/scan
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "event_id": "{{$guid}}",
  "tag_uid": "{{tagUid}}",
  "room_id": {{createRoom.response.body.$.id}},
  "occurred_at": "{{$datetime iso8601}}",
  "device_id": "presence-http"
}

### 10. Tap again: the same person toggles (expect 200, event.type "exit")
# @prompt apiKey Enter the device key (RFID_API_KEY)
POST {{baseUrl}}/api/presence/event
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "event_id": "{{$guid}}",
  "source": "rfid",
  "tag_uid": "{{tagUid}}",
  "room_id": {{createRoom.response.body.$.id}},
  "occurred_at": "{{$datetime iso8601}}",
  "device_id": "presence-http"
}

### 11a. Duplicate check, first send: a new tap (expect 200, "duplicate": false, type "enter")
# @name dupFirst
# @prompt apiKey Enter the device key (RFID_API_KEY)
POST {{baseUrl}}/api/presence/event
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "event_id": "{{$guid}}",
  "source": "rfid",
  "tag_uid": "{{tagUid}}",
  "room_id": {{createRoom.response.body.$.id}},
  "occurred_at": "{{$datetime iso8601}}",
  "device_id": "presence-http"
}

### 11b. Duplicate check, same event_id again: not counted twice (expect 200, "duplicate": true)
# @prompt apiKey Enter the device key (RFID_API_KEY)
POST {{baseUrl}}/api/presence/event
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "event_id": "{{dupFirst.response.body.$.event.event_id}}",
  "source": "rfid",
  "tag_uid": "{{tagUid}}",
  "room_id": {{createRoom.response.body.$.id}},
  "occurred_at": "{{$datetime iso8601}}",
  "device_id": "presence-http"
}

### 12. Wrong device key is rejected (expect 401 "Invalid or missing API key")
POST {{baseUrl}}/api/presence/event
Content-Type: application/json
Accept: application/json
X-API-Key: not-the-real-key

{
  "event_id": "{{$guid}}",
  "source": "rfid",
  "tag_uid": "{{tagUid}}",
  "room_id": {{createRoom.response.body.$.id}},
  "occurred_at": "{{$datetime iso8601}}"
}

### 13. Room status: you are PRESENT in "Demo Period", verification RFID_ONLY (expect 200)
GET {{baseUrl}}/api/presence/rooms/{{createRoom.response.body.$.id}}/status
Accept: application/json

### 14. Room periods: the current period and recent ones (expect 200)
GET {{baseUrl}}/api/presence/rooms/{{createRoom.response.body.$.id}}/periods
Accept: application/json

### 15. Room events, newest first (expect 200; the taps above)
GET {{baseUrl}}/api/rfid/rooms/{{createRoom.response.body.$.id}}/events
Accept: application/json

### 16. Taps the camera has not checked yet, as the camera polls (expect 200)
# @prompt apiKey Enter the device key (RFID_API_KEY)
GET {{baseUrl}}/api/presence/rooms/{{createRoom.response.body.$.id}}/taps/pending
Accept: application/json
X-API-Key: {{apiKey}}

### 17. Schedule override: no periods in this room on a date, e.g. an assembly (expect 201)
# @name override
POST {{baseUrl}}/api/presence/schedules/overrides
Content-Type: application/json
Accept: application/json

{
  "date": "2030-01-02",
  "room_id": {{createRoom.response.body.$.id}},
  "schedule_id": null,
  "note": "Assembly, no periods"
}

### 18. List overrides from a date onward (expect 200; includes the override)
GET {{baseUrl}}/api/presence/schedules/overrides?from=2030-01-01
Accept: application/json

### 19. Delete the override (expect 200)
DELETE {{baseUrl}}/api/presence/schedules/overrides/{{override.response.body.$.id}}
Accept: application/json

### 20. Unknown presence path answers in JSON, not an HTML page (expect 404 JSON)
GET {{baseUrl}}/api/presence/classrooms/1/status
Accept: application/json

### 21. Cleanup: remove the demo tag (expect 200). The room keeps its taps, so it is not deleted.
DELETE {{baseUrl}}/api/rfid/tags/{{tagUid}}
Accept: application/json

### 22. Self-registration: your card (expect 200; "cards" is empty after step 21)
GET {{baseUrl}}/api/rfid/cards/me
Accept: application/json

### 23. Open a 60-second window to register your own card at the room's reader (expect 201; 409 if you already have a card)
# @name claim
POST {{baseUrl}}/api/rfid/claims
Content-Type: application/json
Accept: application/json

{
  "room_id": {{createRoom.response.body.$.id}}
}

### 24. Within 60 seconds, tap a new card, as the reader sends it (expect 200, "status": "card_registered")
# @prompt apiKey Enter the device key (RFID_API_KEY)
POST {{baseUrl}}/api/rfid/scan
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "event_id": "{{$guid}}",
  "tag_uid": "{{newTagUid}}",
  "room_id": {{createRoom.response.body.$.id}},
  "occurred_at": "{{$datetime iso8601}}",
  "device_id": "presence-http"
}

### 25. Claim status: registered, card shown by its last 4 digits (expect 200)
GET {{baseUrl}}/api/rfid/claims/{{claim.response.body.$.id}}
Accept: application/json

### 26. Cleanup: remove the self-registered card (expect 200)
DELETE {{baseUrl}}/api/rfid/tags/{{newTagUid}}
Accept: application/json

### 27. Period enrollment: give the demo schedule two periods, "Period A" running now for an hour
# and "Period B" at midnight (expect 200). Uses this machine's clock as Pacific time, the
# schedule's timezone; run between 01:00 and 23:00 so Period A does not cross midnight.
PUT {{baseUrl}}/api/presence/schedules/{{createSchedule.response.body.$.id}}
Content-Type: application/json
Accept: application/json

{
  "blocks": [
    {"name": "Period A", "weekdays": "mon,tue,wed,thu,fri,sat,sun", "start": "{{$localDatetime 'HH:mm'}}", "end": "{{$localDatetime 'HH:mm' 1 h}}"},
    {"name": "Period B", "weekdays": "mon,tue,wed,thu,fri,sat,sun", "start": "00:00", "end": "00:01"}
  ]
}

### 28. End the step 8 manual period early by starting a 1-second one, so the schedule decides again (expect 201)
POST {{baseUrl}}/api/presence/rooms/{{createRoom.response.body.$.id}}/periods
Content-Type: application/json
Accept: application/json

{
  "name": "End Demo Period",
  "duration_seconds": 1
}

### 29. Log in as a student (any non-staff account; expect 200). This replaces the staff login cookie.
# @name studentLogin
# @prompt studentUid Enter a student's user ID
# @prompt studentPassword Enter the student's password
POST {{baseUrl}}/api/authenticate
Content-Type: application/json
Accept: application/json

{
  "uid": "{{studentUid}}",
  "password": "{{studentPassword}}"
}

### 30. Rooms a student can enroll in, with their periods (expect 200; the demo room lists
# ["Period B", "Period A"] in start-time order, and no member uids)
GET {{baseUrl}}/api/presence/enroll/rooms
Accept: application/json

### 31. Enroll in a period the room does not have (expect 400 with the valid "periods")
PUT {{baseUrl}}/api/presence/enroll/me
Content-Type: application/json
Accept: application/json

{
  "room_id": {{createRoom.response.body.$.id}},
  "period_name": "Period 9"
}

### 32. Enroll in Period A (expect 200; enrollments has the demo room, "Period A")
PUT {{baseUrl}}/api/presence/enroll/me
Content-Type: application/json
Accept: application/json

{
  "room_id": {{createRoom.response.body.$.id}},
  "period_name": "Period A"
}

### 33. My enrollment (expect 200; same as step 32)
GET {{baseUrl}}/api/presence/enroll/me
Accept: application/json

### 34. A student cannot read the roster (expect 403)
GET {{baseUrl}}/api/presence/rooms/{{createRoom.response.body.$.id}}/status
Accept: application/json

### 35. Log back in as the step 1 Admin or Teacher (expect 200)
POST {{baseUrl}}/api/authenticate
Content-Type: application/json
Accept: application/json

{
  "uid": "{{login.request.body.$.uid}}",
  "password": "{{login.request.body.$.password}}"
}

### 36. Room status in scheduled "Period A" ("period.source": "scheduled"): the student is listed with
# "period_name": "Period A", and you with "period_name": null (every period) (expect 200)
GET {{baseUrl}}/api/presence/rooms/{{createRoom.response.body.$.id}}/status
Accept: application/json

### 37. Log in as the student again (expect 200)
POST {{baseUrl}}/api/authenticate
Content-Type: application/json
Accept: application/json

{
  "uid": "{{studentLogin.request.body.$.uid}}",
  "password": "{{studentLogin.request.body.$.password}}"
}

### 38. Switch to Period B by enrolling in the same room again (expect 200; "period_name": "Period B")
PUT {{baseUrl}}/api/presence/enroll/me
Content-Type: application/json
Accept: application/json

{
  "room_id": {{createRoom.response.body.$.id}},
  "period_name": "Period B"
}

### 39. Log back in as staff (expect 200)
POST {{baseUrl}}/api/authenticate
Content-Type: application/json
Accept: application/json

{
  "uid": "{{login.request.body.$.uid}}",
  "password": "{{login.request.body.$.password}}"
}

### 40. Room status, still "Period A": the student is no longer listed (expect 200)
GET {{baseUrl}}/api/presence/rooms/{{createRoom.response.body.$.id}}/status
Accept: application/json

### 41. Start a 2-minute manual period (a demo) (expect 201)
POST {{baseUrl}}/api/presence/rooms/{{createRoom.response.body.$.id}}/periods
Content-Type: application/json
Accept: application/json

{
  "name": "Demo Period",
  "duration_seconds": 120
}

### 42. Room status in the manual period: every member is listed, the student too (expect 200)
GET {{baseUrl}}/api/presence/rooms/{{createRoom.response.body.$.id}}/status
Accept: application/json

### 43. Staff can set a member's period too (expect 200; "members" shows the student in "Period A")
POST {{baseUrl}}/api/presence/rooms/{{createRoom.response.body.$.id}}/members/{{studentLogin.response.body.$.user.uid}}
Content-Type: application/json
Accept: application/json

{
  "period_name": "Period A"
}

### 44. Log in as the student again (expect 200)
POST {{baseUrl}}/api/authenticate
Content-Type: application/json
Accept: application/json

{
  "uid": "{{studentLogin.request.body.$.uid}}",
  "password": "{{studentLogin.request.body.$.password}}"
}

### 45. Leave the room (expect 200; "enrollments": [])
DELETE {{baseUrl}}/api/presence/enroll/me/{{createRoom.response.body.$.id}}
Accept: application/json
